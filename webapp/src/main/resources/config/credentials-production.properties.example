#
# Copy content below to file credentials-production.properties (which is gitignored) and set production credentials
#

# Production credentials: JDBC, mail, etc. (selected by credentials-selection.properties in deployment builds)

# DB:
jdbc.url=jdbc:postgresql://localhost/paw-2026a-11
jdbc.username=paw-2026a-11
jdbc.password=PASSWORD_HERE

# Mail:
mail.host=smtp.example.com
mail.port=587
mail.username=botecito.dev@gmail.com
mail.password=PASSWORD_HERE

# App URLs:
app.baseUrl=http://pawserver.it.itba.edu.ar/paw-2026a-11

# Remember-me: private key used to sign the remember-me cookie signature.
# Generate a long random value, e.g. `openssl rand -base64 48`.
rememberMe.key=GENERATE_A_LONG_RANDOM_VALUE
