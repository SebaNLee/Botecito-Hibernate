<FindBugsFilter>
  <!--
    Spring-injected service/DAO fields are interfaces managed by the container.
    SpotBugs incorrectly treats them as mutable objects (EI_EXPOSE_REP2).
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Class name="~ar\.edu\.itba\.paw\.(services|webapp\.controller)\..+"/>
  </Match>
  <!--
    DTOs in services.dto are immutable carriers that hold references to domain
    entities and byte buffers. Returning them by reference is intentional;
    callers do not mutate them.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    <Class name="~ar\.edu\.itba\.paw\.services\.dto\..+"/>
  </Match>
  <!--
    Page model exposes the loaded Item for the view; the domain type has no
    copy API and cloning would not preserve identity semantics for the screen.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP"/>
    <Class name="ar.edu.itba.paw.services.ManageAvailabilityPageModel"/>
    <Method name="getItem" returns="ar.edu.itba.paw.models.Item"/>
  </Match>
</FindBugsFilter>
