#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WEBAPP_DIR="$ROOT_DIR/webapp"
JETTY_URL="http://localhost:8080"
RUN_DIR="$ROOT_DIR/target/jetty-helper"
TAILWIND_PID_FILE="$RUN_DIR/tailwind.pid"
JETTY_PID_FILE="$RUN_DIR/jetty.pid"
TAILWIND_LOG="$RUN_DIR/tailwind.log"
JETTY_LOG="$RUN_DIR/jetty.log"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"

usage() {
  echo "Usage: $0 {start|stop}"
  exit 1
}

start_process() {
  local name="$1"
  local pid_file="$2"
  local log_file="$3"
  shift
  shift
  shift

  nohup "$@" >"$log_file" 2>&1 &
  STARTED_PID=$!
  disown "$STARTED_PID" 2>/dev/null || true
  echo "$STARTED_PID" >"$pid_file"
  echo "$name started with PID $STARTED_PID."
}

is_jetty_running() {
  curl --silent --fail --head --max-time 2 "$JETTY_URL" >/dev/null 2>&1
}

is_pid_running() {
  local pid="$1"
  kill -0 "$pid" 2>/dev/null
}

is_postgres_running() {
  pg_isready -h "$POSTGRES_HOST" -p "$POSTGRES_PORT" >/dev/null 2>&1
}

read_pid() {
  local pid_file="$1"

  if [[ -f "$pid_file" ]]; then
    cat "$pid_file"
  fi
}

cleanup_pid_file() {
  local pid_file="$1"

  if [[ -f "$pid_file" ]]; then
    rm -f "$pid_file"
  fi
}

wait_for_jetty() {
  local attempts=30

  for ((i = 1; i <= attempts; i++)); do
    if is_jetty_running; then
      return 0
    fi
    sleep 1
  done

  return 1
}

wait_for_pid() {
  local pid="$1"
  local attempts=5

  for ((i = 1; i <= attempts; i++)); do
    if is_pid_running "$pid"; then
      return 0
    fi
    sleep 1
  done

  return 1
}

print_log_tail() {
  local log_file="$1"
  local lines="${2:-20}"

  if [[ -f "$log_file" ]]; then
    echo
    echo "Last $lines lines of $log_file:"
    tail -n "$lines" "$log_file"
  fi
}

report_startup_failure() {
  if [[ -f "$JETTY_LOG" ]] && grep -q "Address already in use" "$JETTY_LOG"; then
    echo "Jetty failed to start because port 8080 is already in use."
    echo "Stop the process using port 8080, or change the Jetty port in webapp/pom.xml."
  elif [[ -f "$JETTY_LOG" ]] && grep -q "BUILD FAILURE" "$JETTY_LOG"; then
    echo "Jetty failed during startup. See the log excerpt below."
  fi

  if [[ -f "$TAILWIND_LOG" ]] && grep -q "watchman: not found" "$TAILWIND_LOG"; then
    echo "Tailwind watch exited because 'watchman' is not installed."
    echo "That does not block Jetty startup, but CSS will not auto-rebuild in watch mode."
  fi

  print_log_tail "$JETTY_LOG" 25
  print_log_tail "$TAILWIND_LOG" 15
}

ensure_project_root() {
  cd "$ROOT_DIR"

  if [[ ! -f "$ROOT_DIR/pom.xml" || ! -f "$WEBAPP_DIR/pom.xml" ]]; then
    echo "This script must be run from the project root."
    exit 1
  fi

  mkdir -p "$RUN_DIR"
}

ensure_process_not_running() {
  local name="$1"
  local pid_file="$2"
  local pid

  pid="$(read_pid "$pid_file")"
  if [[ -n "${pid:-}" ]] && is_pid_running "$pid"; then
    echo "$name is already running with PID $pid."
    return 0
  fi

  cleanup_pid_file "$pid_file"
  return 1
}

wait_for_postgres() {
  local attempts=30

  for ((i = 1; i <= attempts; i++)); do
    if is_postgres_running; then
      return 0
    fi
    sleep 1
  done

  return 1
}

start_postgres() {
  if is_postgres_running; then
    echo "PostgreSQL is already running."
    return 0
  fi

  if ! command -v pg_isready >/dev/null 2>&1; then
    echo "pg_isready is not available. Install PostgreSQL client tools first."
    exit 1
  fi

  echo "Starting PostgreSQL..."
  sudo service postgresql start

  if wait_for_postgres; then
    echo "PostgreSQL is up."
  else
    echo "PostgreSQL did not become ready on $POSTGRES_HOST:$POSTGRES_PORT."
    exit 1
  fi
}

stop_postgres() {
  if ! command -v pg_isready >/dev/null 2>&1; then
    echo "PostgreSQL readiness check is unavailable; skipping DB stop."
    return 0
  fi

  if ! is_postgres_running; then
    echo "PostgreSQL is not running."
    return 0
  fi

  echo "Stopping PostgreSQL..."
  sudo service postgresql stop
  echo "PostgreSQL stopped."
}

start_jetty() {
  ensure_project_root
  start_postgres

  echo "Compiling base modules from the root..."
  mvn install
  mvn compile

  cd "$WEBAPP_DIR"

  echo "Compiling webapp..."
  mvn install
  mvn compile

  echo "Starting background processes..."
  if ensure_process_not_running "Tailwind watch" "$TAILWIND_PID_FILE"; then
    TAILWIND_PID="$(read_pid "$TAILWIND_PID_FILE")"
  else
    start_process "Tailwind watch" "$TAILWIND_PID_FILE" "$TAILWIND_LOG" mvn tailwind:watch
    TAILWIND_PID="$STARTED_PID"
  fi

  if ensure_process_not_running "Jetty" "$JETTY_PID_FILE"; then
    echo "Jetty is already running."
  elif is_jetty_running; then
    echo "Jetty is already running at $JETTY_URL."
  else
    start_process "Jetty" "$JETTY_PID_FILE" "$JETTY_LOG" mvn jetty:run
  fi

  echo
  if wait_for_pid "$TAILWIND_PID"; then
    echo "Tailwind watch is running."
  else
    echo "Tailwind watch did not stay running."
  fi

  if wait_for_jetty; then
    echo "Jetty is up."
  else
    cleanup_pid_file "$JETTY_PID_FILE"
    echo "Jetty did not respond at $JETTY_URL within 30 seconds."
    report_startup_failure
    exit 1
  fi

  echo "Processes started."
  printf 'Open: \033]8;;%s\033\\%s\033]8;;\033\\\n' "$JETTY_URL" "$JETTY_URL"
  echo "Logs:"
  echo "  $JETTY_LOG"
  echo "  $TAILWIND_LOG"
}

stop_tailwind() {
  local pid

  pid="$(read_pid "$TAILWIND_PID_FILE")"
  if [[ -z "${pid:-}" ]]; then
    echo "Tailwind watch is not running."
    return 0
  fi

  if is_pid_running "$pid"; then
    kill "$pid"
  fi
  cleanup_pid_file "$TAILWIND_PID_FILE"
  echo "Tailwind watch stopped."
}

stop_jetty() {
  local pid

  pid="$(read_pid "$JETTY_PID_FILE")"

  if [[ -z "${pid:-}" ]]; then
    echo "Jetty is not running."
    return 0
  fi

  if is_pid_running "$pid"; then
    kill "$pid"
  fi
  cleanup_pid_file "$JETTY_PID_FILE"
  echo "Jetty stopped."
}

main() {
  if [[ $# -ne 1 ]]; then
    usage
  fi

  case "$1" in
    start)
      start_jetty
      ;;
    stop)
      stop_tailwind
      stop_jetty
      stop_postgres
      ;;
    *)
      usage
      ;;
  esac
}

main "$@"
